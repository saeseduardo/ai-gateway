# Copy this file to .env and fill in the values before running
# `docker compose up`. .env is gitignored — never commit real secrets.

# --- Provider credentials (required, no defaults) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Provider settings (optional overrides) ---
GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
GATEWAY_OPENAI_TIMEOUT=30s
GATEWAY_ANTHROPIC_BASE_URL=https://api.anthropic.com
GATEWAY_ANTHROPIC_TIMEOUT=30s

# --- HTTP server (optional overrides) ---
GATEWAY_SERVER_PORT=8080
GATEWAY_SERVER_READ_TIMEOUT=15s
GATEWAY_SERVER_WRITE_TIMEOUT=15s
GATEWAY_SERVER_IDLE_TIMEOUT=60s
GATEWAY_SERVER_SHUTDOWN_TIMEOUT=10s

# --- Redis (optional overrides; not yet consumed by the app code) ---
# In docker-compose this is pointed at the bundled redis service.
GATEWAY_REDIS_ADDRESS=redis:6379
GATEWAY_REDIS_PASSWORD=
GATEWAY_REDIS_DB=0

# --- Telemetry (optional override; no metrics listener wired up yet) ---
GATEWAY_TELEMETRY_METRICS_PORT=9090
